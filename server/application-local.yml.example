# 复制为 application-local.yml 后填入真实值；该文件已被 .gitignore 忽略。
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/myblog
    username: myblog
    password: 在这里填数据库密码

app:
  jwt:
    # 至少 32 字节的随机字符串
    secret: 在这里填一段足够长的随机字符串
  seed:
    admin-email: admin@luyu.local
    admin-password: 在这里填管理员初始密码
